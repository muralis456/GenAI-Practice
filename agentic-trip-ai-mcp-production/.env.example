# Required in production
DB_URL=jdbc:postgresql://localhost:5432/travel_agent
DB_USERNAME=travel_app
DB_PASSWORD=replace-with-a-strong-secret
SESSION_COOKIE_SECURE=true

# External providers
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=
TRAVEL_MCP_SERVER_URL=http://localhost:8090
OLLAMA_BASE_URL=http://localhost:11434

# Runtime safety
TRAVEL_MAX_CONCURRENT_PLANS=12
TRAVEL_MAX_CONCURRENT_PLANS_PER_USER=2
TRAVEL_MAX_CONCURRENT_SPECIALISTS=12
TRAVEL_PLAN_QUEUE_CAPACITY=40
TRAVEL_RATE_LIMIT_PER_WINDOW=6
TRAVEL_RATE_LIMIT_WINDOW_SECONDS=60
APP_BROWSER_ENABLED=false
